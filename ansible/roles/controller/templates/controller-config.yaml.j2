---
# the configuration of sak-backend, rendered by the controller role from the inventory sakctl writes
# (sak_name, sak_dns_mode, sak_root_domain, sak_api_token_sha256, sak_admin_email, sak_smtp_*); the login
# mails come from noreply@<root domain>;
# the secrets come from backend.env: a value starting with $ is an environment variable
ktor:
  deployment:
    port: 8080
sak:
  name: {{ sak_name }}
  dns_mode: {{ sak_dns_mode }}
  api_token_sha256: {{ sak_api_token_sha256 }}
  data_dir: /storage/data/backend/data
  root_domain: {{ sak_root_domain }}
  auth:
    # the admin signs in with the password of the deployment
    admin_password: $SAK_ADMIN_PASSWORD_HASH
{% if sak_smtp_enabled | bool %}
    # multi user: the e-mail login, the admin is its first user; without a mail server the
    # deployment is single user, only the admin signs in, with the password
    admins:
      - {{ sak_admin_email }}
    smtp:
      host: $SAK_SMTP_HOST
      port: $SAK_SMTP_PORT
      username: $SAK_SMTP_USERNAME
      password: $SAK_SMTP_PASSWORD
      from: noreply@{{ sak_root_domain }}
      tls: {{ sak_smtp_tls | bool | lower }}
      starttls: {{ sak_smtp_starttls | bool | lower }}
{% endif %}
  # the public addresses of the server, each a comma separated list, from backend.env
  addresses:
    ipv4: $SAK_IPV4
    ipv6: $SAK_IPV6
