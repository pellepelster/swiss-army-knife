---
# the configuration of sak-backend, rendered by the controller role: the sak name, the dns mode, the
# root domain and the sha-256 of the admin api token come from the inventory sakctl writes
# (sak_name, sak_dns_mode, sak_root_domain, sak_api_token_sha256)
ktor:
  deployment:
    port: 8080
sak:
  name: {{ sak_name }}
  dns_mode: {{ sak_dns_mode }}
  api_token_sha256: {{ sak_api_token_sha256 }}
  data_dir: /storage/data/backend/data
  root_domain: {{ sak_root_domain }}
  # the keys the secrets are encrypted with by their version, the highest encrypts; the
  # provisioning of the server creates them and writes them to backend.env
  secret_keys:
    1: $SAK_SECRET_KEY_1
  auth:
    admins:
      - pelle@pelle.io
    smtp:
      host: $SAK_SMTP_HOST
      port: $SAK_SMTP_PORT
      username: $SAK_SMTP_USERNAME
      password: $SAK_SMTP_PASSWORD
      from: noreply@mail.pelle.io
      # implicit tls on port 465
      tls: true
  # reads the text in the photos of notes, the token comes from pass (openrouter/pelle/api-key)
  openrouter:
    api_token: $SAK_OPENROUTER_API_TOKEN
  # the public addresses of the server, each a comma separated list; the provisioning of the
  # server writes them to backend.env
  addresses:
    ipv4: $SAK_IPV4
    ipv6: $SAK_IPV6
