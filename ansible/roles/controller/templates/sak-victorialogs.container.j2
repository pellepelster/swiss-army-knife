# {{ ansible_managed }}
[Unit]
Description=sak-victorialogs

[Container]
ContainerName=sak-victorialogs
Image={{ controller_victorialogs_image }}
Pull=missing
# listens on localhost only, vector ships to it and the controller queries it there
Network=host
User={{ controller_uid }}
Group={{ controller_gid }}
Volume={{ controller_victorialogs_data_path }}:/victoria-logs-data
Exec=-storageDataPath=/victoria-logs-data -httpListenAddr=127.0.0.1:9428 -retentionPeriod={{ controller_victorialogs_retention }} -retention.maxDiskSpaceUsageBytes={{ controller_victorialogs_max_disk_usage }}
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
