#!/bin/bash
# {{ ansible_managed }}
#
# sak-backend <command>: the maintenance of the deployment {{ sak_name }} on its server, run by
# sakctl through ssh as root. Messages go to standard error, each line starting with
# "sak-backend: ". The commands that change something take one lock, so only one of them runs.
# Exit codes: 0 done, 1 failed or wrong arguments, 2 another command holds the lock
#
#   backup <age recipient>  the data below {{ sak_data_dir }} as one tar stream, compressed with
#                           zstd and encrypted with age to <recipient> (the public half of the
#                           backup key sakctl derives), on standard output. Nothing stops: the
#                           database is copied with VACUUM INTO, victorialogs with its own
#                           snapshots, the files as hard links of one moment
#   restore                 replaces the data with the backup on standard input, decrypted by
#                           sakctl and still compressed with zstd. The archive is extracted and
#                           checked first (its deployment, a version not newer than the one of the
#                           server, the database); until then nothing changes. The files of the
#                           provisioning stay
#   reboot-pending          whether a reboot is pending and why, as json on standard output
#   update                  upgrades all packages, none is removed; what changed and whether a
#                           reboot is pending, as json
#   reboot [--if-pending]   stops the deployment in order and reboots the server in some seconds,
#                           holding the lock until it goes down; as json. With --if-pending only
#                           when a reboot is pending
set -euo pipefail

# the units of the deployment in the order a reboot stops them: no request comes in first
units=(sak-ingress sak-backend sak-vector sak-victorialogs)
# how long a command waits for apt and dpkg, in seconds
apt_wait={{ backend_apt_wait }}

step() { echo "sak-backend: $*" >&2; }

# the lock of the commands that change something, held until the script ends
lock() {
  exec 9>{{ backend_lock_file | quote }}
  if ! flock -n 9; then
    step "another backup, restore, update or reboot runs"
    exit 2
  fi
}

# a failed maintenance command answers its error as json too
fail_json() {
  python3 -c 'import json, sys; print(json.dumps({"error": sys.argv[1]}))' "$1"
  step "$1"
  exit 1
}

# waits until no apt or dpkg runs (unattended upgrades): dpkg locks with fcntl, so does lockf
wait_for_dpkg() {
  python3 - "$apt_wait" <<'EOF' || fail_json "apt or dpkg still runs after $apt_wait seconds"
import fcntl, sys, time
deadline = time.monotonic() + int(sys.argv[1])
while True:
    try:
        with open("/var/lib/dpkg/lock-frontend", "w") as lock:
            fcntl.lockf(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        sys.exit(0)
    except OSError:
        if time.monotonic() > deadline:
            sys.exit(1)
        time.sleep(5)
EOF
}

# whether a reboot is pending, as json: /run/reboot-required, the running kernel against the
# newest one installed, the services needrestart finds on old libraries, the upgrades of dpkg
# since the boot
pending_json() {
  local installed services
  installed=$(find /boot -maxdepth 1 -name 'vmlinuz-*' -printf '%f\n' 2>/dev/null | sed 's/^vmlinuz-//' | sort -V | tail -n 1)
  services=""
  if command -v needrestart >/dev/null; then
    services=$(needrestart -b -r l 2>/dev/null | sed -n 's/^NEEDRESTART-SVC: //p' || true)
  fi
  python3 - "$(uname -r)" "$installed" "$services" <<'EOF'
import datetime, json, os, re, sys, time
running, installed, services = sys.argv[1], sys.argv[2], [s for s in sys.argv[3].split("\n") if s]
booted = next(int(line.split()[1]) for line in open("/proc/stat") if line.startswith("btime "))
utc = lambda at: datetime.datetime.fromtimestamp(at, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
reasons = []
if os.path.exists("/run/reboot-required"):
    reasons.append("reboot-required")
if installed and installed != running:
    reasons.append("kernel")
updates = []
if os.path.exists("/var/log/dpkg.log"):
    for line in open("/var/log/dpkg.log", errors="replace"):
        # 2026-10-30 03:12:44 upgrade openssl:amd64 3.5.1-1 3.5.4-1
        match = re.match(r"(\S+ \S+) upgrade ([^:\s]+)\S* (\S+) (\S+)$", line.strip())
        if not match:
            continue
        at = time.mktime(time.strptime(match[1], "%Y-%m-%d %H:%M:%S"))
        if at >= booted:
            updates.append({"package": match[2], "from": match[3], "to": match[4], "time": utc(at)})
print(json.dumps({
    "reboot_pending": bool(reasons),
    "reasons": reasons,
    "kernel": {"running": running, "installed": installed or running},
    "services": services,
    "updates_since_boot": updates,
    "booted_at": utc(booted),
}))
EOF
}

reboot_pending() {
  pending_json
}

# the installed packages and their versions, one "<package> <version>" a line
packages() {
  dpkg-query -W -f='${db:Status-Abbrev} ${Package} ${Version}\n' | awk '$1 == "ii" { print $2, $3 }' | sort
}

update() {
  lock
  wait_for_dpkg
  local before after pending
  before=$(packages)
  export DEBIAN_FRONTEND=noninteractive
  step "updating the package lists"
  apt-get -q -o DPkg::Lock::Timeout="$apt_wait" update >&2 || fail_json "apt-get update failed"
  step "upgrading the packages"
  apt-get -q -y -o DPkg::Lock::Timeout="$apt_wait" -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold --with-new-pkgs upgrade >&2 || fail_json "apt-get upgrade failed"
  after=$(packages)
  pending=$(pending_json)
  python3 - "$before" "$after" "$pending" <<'EOF'
import json, sys
parse = lambda text: dict(line.split(" ", 1) for line in text.split("\n") if line)
before, after, pending = parse(sys.argv[1]), parse(sys.argv[2]), json.loads(sys.argv[3])
print(json.dumps({
    "upgraded": [{"package": p, "from": before[p], "to": v} for p, v in sorted(after.items()) if p in before and before[p] != v],
    "installed": [{"package": p, "to": v} for p, v in sorted(after.items()) if p not in before],
    "reboot_pending": pending["reboot_pending"],
    "reasons": pending["reasons"],
}))
EOF
  step "done"
}

reboot_server() {
  local if_pending=false
  case "${1:-}" in
    "") ;;
    --if-pending) if_pending=true ;;
    *) step "usage: sak-backend reboot [--if-pending]"; exit 1 ;;
  esac
  lock
  local pending reasons
  pending=$(pending_json)
  reasons=$(python3 -c 'import json, sys; print(json.dumps(json.loads(sys.argv[1])["reasons"]))' "$pending")
  if [ "$if_pending" = true ] && [ "$reasons" = "[]" ]; then
    echo '{"rebooting": false, "reasons": []}'
    step "no reboot pending"
    return
  fi
  wait_for_dpkg
  step "stopping the deployment"
  systemctl stop "${units[@]}"
  sync
  # some seconds, so the answer leaves through ssh first; the lock goes to a process that lives
  # until the server goes down, so no backup or restore starts in between
  setsid sleep 600 </dev/null >/dev/null 2>&1 &
  systemd-run --quiet --on-active=5s --unit=sak-backend-reboot systemctl reboot
  python3 -c '
import datetime, json, sys
at = datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=5)
print(json.dumps({"rebooting": True, "at": at.strftime("%Y-%m-%dT%H:%M:%SZ"), "reasons": json.loads(sys.argv[1])}))
' "$reasons"
  step "rebooting in 5 seconds"
}

usage() {
  step "usage: sak-backend backup <age recipient> | restore | reboot-pending | update | reboot [--if-pending]"
  exit 1
}

backup() {
  local recipient="${1:-}"
  if [[ ! "$recipient" =~ ^age1[02-9ac-hj-np-z]{58}$ ]]; then
    step "usage: sak-backend backup <age recipient>"
    exit 1
  fi

  data={{ sak_data_dir | quote }}
  database={{ (backend_data_path ~ '/sak.db') | quote }}
  staging={{ backend_backup_staging_path | quote }}
  victorialogs={{ backend_victorialogs_data_path | quote }}
  snapshot_api=http://127.0.0.1:9428/internal/partition/snapshot

  lock
  auth_key=$(cat {{ backend_victorialogs_auth_key_file | quote }})
  snapshots=()
  cleanup() {
    for snapshot in "${snapshots[@]}"; do
      curl -fsS -X POST --data-urlencode "authKey=$auth_key" --data-urlencode "path=$snapshot" \
        "$snapshot_api/delete" >/dev/null || step "snapshot $snapshot not deleted"
    done
    rm -rf "$staging"
  }
  trap cleanup EXIT

  rm -rf "$staging"
  # the user of sak copies the database into it
  install -d -m 0750 -o root -g {{ backend_group }} "$staging"
  install -d -m 0700 -o {{ backend_user }} -g {{ backend_group }} "$staging/database"

  # the checkpoint of vector before the snapshot of victorialogs: a line can be sent again after
  # a restore, but none is lost
  step "copying the checkpoints of vector"
  cp -a {{ backend_vector_data_path | quote }} "$staging/vector"

  step "taking a snapshot of victorialogs"
  install -d -m 0700 -o {{ backend_user }} -g {{ backend_group }} "$staging/victorialogs" "$staging/victorialogs/partitions"
  answer=$(curl -fsS -X POST --data-urlencode "authKey=$auth_key" "$snapshot_api/create")
  mapfile -t snapshots < <(python3 -c 'import json, sys; print("\n".join(json.load(sys.stdin)))' <<<"$answer")
  for snapshot in "${snapshots[@]}"; do
    # /victoria-logs-data/partitions/<day>/snapshots/<id>, the path in the container; the delete
    # takes it as it is
    day=$(basename "$(dirname "$(dirname "$snapshot")")")
    install -d -m 0700 -o {{ backend_user }} -g {{ backend_group }} "$staging/victorialogs/partitions/$day"
    cp -al "$victorialogs${snapshot#/victoria-logs-data}/." "$staging/victorialogs/partitions/$day/"
  done

  # the database before the files: every file a row of the copy refers to is there already
  step "copying the database"
  runuser -u {{ backend_user }} -- sqlite3 "$database" "VACUUM INTO '$staging/database/sak.db'"
  integrity=$(runuser -u {{ backend_user }} -- sqlite3 "$staging/database/sak.db" "PRAGMA integrity_check")
  if [ "$integrity" != "ok" ]; then
    step "the copy of the database is damaged: $integrity"
    exit 1
  fi

  # hard links of the files as they are now; the backend writes a file anew and moves it into
  # place, so a link keeps the file of this moment. The files of the provisioning are no data
  step "linking the files"
  install -d -m 0750 -o root -g {{ backend_group }} "$staging/backend"
  cp -al {{ backend_data_path | quote }} "$staging/backend/data"
  rm -f "$staging/backend/data/sak.db" "$staging/backend/data/sak.db-wal" "$staging/backend/data/sak.db-shm"
  mv "$staging/database/sak.db" "$staging/backend/data/sak.db"
  rmdir "$staging/database"
  for entry in "$data"/* "$data"/.[!.]*; do
    [ -e "$entry" ] || continue
    case "$(basename "$entry")" in
      backend | vector | victorialogs) ;;
      *) cp -al "$entry" "$staging/" ;;
    esac
  done

  size=$(du -sb "$staging" | cut -f1)
  digest=$(podman image inspect --format '{% raw %}{{.Digest}}{% endraw %}' {{ backend_image | quote }} 2>/dev/null || true)
  python3 - "$staging/backup.json" "$size" "$digest" <<'EOF'
import datetime, json, sys
path, size, digest = sys.argv[1], int(sys.argv[2]), sys.argv[3]
manifest = {
    "format": 1,
    # the version of sak the server runs
    "version": {{ sak_version | to_json }},
    "name": {{ sak_name | to_json }},
    "time": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z"),
    "backend_image": digest,
    "size": size,
}
with open(path, "w") as file:
    json.dump(manifest, file, indent=2)
EOF

  step "sending $size bytes, compressed and encrypted"
  mapfile -t entries < <(cd "$staging" && find . -mindepth 1 -maxdepth 1 ! -name backup.json -printf '%P\n' | sort)
  # tar ends with 1 when a file changed while it was read (the access log of caddy), which is no
  # failure; the plain stream never leaves the server
  set +e
  tar --create --file=- --numeric-owner --warning=no-file-changed -C "$staging" backup.json "${entries[@]}" \
    | zstd -3 -T0 -q \
    | age -r "$recipient"
  statuses=("${PIPESTATUS[@]}")
  set -e
  if [ "${statuses[0]}" -gt 1 ] || [ "${statuses[1]}" -ne 0 ] || [ "${statuses[2]}" -ne 0 ]; then
    step "the archive failed (tar ${statuses[0]}, zstd ${statuses[1]}, age ${statuses[2]})"
    exit 1
  fi
  step "done"
}

restore() {
  data={{ sak_data_dir | quote }}
  staging={{ backend_restore_staging_path | quote }}
  replaced={{ backend_restore_replaced_path | quote }}

  lock

  # what a restore that did not end left behind is the data from before it, never removed here
  if [ -e "$replaced" ]; then
    step "$replaced is left from a restore that did not end; move its data back or remove it first"
    exit 1
  fi

  stopped=false
  cleanup() {
    rm -rf "$staging"
    if [ "$stopped" = true ]; then
      systemctl start "${units[@]}" || true
    fi
  }
  trap cleanup EXIT

  rm -rf "$staging"
  install -d -m 0700 -o root -g root "$staging"

  step "receiving and extracting the backup"
  zstd -dc -q | tar --extract --file=- --numeric-owner --same-permissions -C "$staging"

  step "checking the backup"
  python3 - "$staging/backup.json" <<'EOF'
import json, sys
manifest = json.load(open(sys.argv[1]))
if manifest.get("format") != 1:
    sys.exit(f"sak-backend: the format {manifest.get('format')} of the backup is not known")
if manifest.get("name") != {{ sak_name | to_json }}:
    sys.exit(f"sak-backend: the backup is of {manifest.get('name')}, not of {{ sak_name }}")
# the backend migrates an older database on its start, a newer one it does not know. latest (a
# backup or a server of no release) is not known, its restore is not stopped
def parsed(version):
    try:
        return tuple(int(part) for part in str(version).split("-")[0].split("."))
    except ValueError:
        return None
backup, server = manifest.get("version"), {{ sak_version | to_json }}
if parsed(backup) is None or parsed(server) is None:
    print(f"sak-backend: the version of the backup ({backup}) or of the server ({server}) is not known, they are not compared", file=sys.stderr)
elif parsed(backup) > parsed(server):
    sys.exit(f"sak-backend: the backup is of version {backup}, the server runs {server}; deploy {backup} or newer first")
EOF
  if [ ! -f "$staging/backend/data/sak.db" ]; then
    step "the backup has no database"
    exit 1
  fi
  integrity=$(sqlite3 "$staging/backend/data/sak.db" "PRAGMA integrity_check")
  if [ "$integrity" != "ok" ]; then
    step "the database of the backup is damaged: $integrity"
    exit 1
  fi
  # the check ran as root, nothing of it may stay for the backend
  rm -f "$staging/backend/data/sak.db-wal" "$staging/backend/data/sak.db-shm"

  # backend/data, and each other directory of the archive (ingress, vector, victorialogs)
  entries=(backend/data)
  for entry in "$staging"/* "$staging"/.[!.]*; do
    [ -e "$entry" ] || continue
    case "$(basename "$entry")" in
      backup.json | backend) ;;
      *) entries+=("$(basename "$entry")") ;;
    esac
  done

  step "stopping the deployment"
  stopped=true
  systemctl stop "${units[@]}"

  step "replacing the data"
  install -d -m 0700 -o root -g root "$replaced" "$replaced/backend"
  for entry in "${entries[@]}"; do
    if [ -e "$data/$entry" ]; then
      mv "$data/$entry" "$replaced/$entry"
    fi
    mv "$staging/$entry" "$data/$entry"
  done

  step "starting the deployment"
  systemctl start "${units[@]}"
  stopped=false
  for _ in $(seq 1 $(({{ backend_restore_wait }} / 5))); do
    if curl -fsS -o /dev/null http://127.0.0.1:8080/api/v1/info; then
      rm -rf "$replaced"
      step "done"
      exit 0
    fi
    sleep 5
  done
  step "the backend does not answer after {{ backend_restore_wait }} seconds; the data from before the restore is in $replaced"
  exit 1
}

command="${1:-}"
[ $# -gt 0 ] && shift
case "$command" in
  backup) backup "$@" ;;
  restore) restore ;;
  reboot-pending) reboot_pending ;;
  update) update ;;
  reboot) reboot_server "$@" ;;
  *) usage ;;
esac
