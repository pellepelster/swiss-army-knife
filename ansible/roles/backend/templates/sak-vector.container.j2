# {{ ansible_managed }}
[Unit]
Description=sak-vector
After=sak-victorialogs.service

[Container]
ContainerName=sak-vector
Image={{ backend_vector_image }}
Pull=missing
# victorialogs only listens on localhost
Network=host
# the ingress writes its access log readable by its own user only
User={{ backend_uid }}
Group={{ backend_gid }}
Volume={{ backend_ingress_data_path }}/log:/var/log/caddy:ro
Volume={{ backend_vector_data_path }}:/var/lib/vector
Volume={{ backend_vector_config_file }}:/etc/vector/vector.yaml:ro
Exec=--config /etc/vector/vector.yaml
ReadOnly=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
