{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwissArmyKnife",
  "mainBinaryName": "sakctl",
  "version": "0.1.0",
  "identifier": "io.pelle.sak.cli",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SwissArmyKnife",
        "width": 640,
        "height": 624,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
