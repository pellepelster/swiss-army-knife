# the admin api stays on localhost:2019, sak-backend configures the routes through it
# and reconfigures caddy after every restart, so the config is not persisted
{
	admin localhost:2019
	persist_config off
	storage file_system /data

	# json log files below /data/log, access logs are only written for servers that enable
	# them, sak-backend does that for its server; error entries carry the request too, so
	# the default log filters it like the access log
	log default {
		output file /data/log/caddy.log {
			roll_size 100MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 64
				request>client_ip ip_mask 24 64
				request>uri query {
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
					delete token
				}
			}
		}
		exclude http.log.access
	}
	# client addresses are masked to their network, presigned url credentials and the
	# login tokens of the apps' signin links never reach the log
	log access {
		output file /data/log/access.log {
			roll_size 100MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 24 64
				request>client_ip ip_mask 24 64
				request>uri query {
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
					delete token
				}
			}
		}
		include http.log.access
	}
}

# nothing is served until sak-backend configures caddy, every request is answered by
# closing the connection
:80 {
	abort
}
