{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/favicon-32.png",
          "/index.html",
          "/notes.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/swagger",
    "!/swagger/**",
    "!/doc/**",
    "!/**/*.js",
    "!/**/*.mjs",
    "!/**/*.css",
    "!/**/*.map",
    "!/**/*.json",
    "!/**/*.webmanifest",
    "!/**/*.png",
    "!/**/*.svg",
    "!/**/*.ico",
    "!/**/*.woff",
    "!/**/*.woff2",
    "!/**/*.txt",
    "!/**/*__*",
    "!/**/*__*/**"
  ]
}
