{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "24b33f0a-0852-4c47-acc3-abca4fe40ca9"
  },
  "newProjectRoot": "projects",
  "projects": {
    "sak-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "{swagger-ui-bundle.js,swagger-ui.css}",
                "input": "node_modules/swagger-ui-dist",
                "output": "swagger"
              },
              {
                "glob": "ibm-plex-sans-latin-{400,600}-normal.woff2",
                "input": "node_modules/@fontsource/ibm-plex-sans/files",
                "output": "swagger/fonts"
              },
              {
                "glob": "ibm-plex-mono-latin-{400,600}-normal.woff2",
                "input": "node_modules/@fontsource/ibm-plex-mono/files",
                "output": "swagger/fonts"
              }
            ],
            "styles": [
              "node_modules/@fortawesome/fontawesome-free/css/fontawesome.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/solid.min.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.scss",
              {
                "input": "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
                "bundleName": "console",
                "inject": false
              },
              {
                "input": "node_modules/@fontsource/ibm-plex-sans/latin-500.css",
                "bundleName": "console",
                "inject": false
              },
              {
                "input": "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
                "bundleName": "console",
                "inject": false
              },
              {
                "input": "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
                "bundleName": "console",
                "inject": false
              },
              {
                "input": "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
                "bundleName": "console",
                "inject": false
              },
              {
                "input": "node_modules/@fontsource/ibm-plex-mono/latin-600.css",
                "bundleName": "console",
                "inject": false
              },
              {
                "input": "src/console-theme/console.scss",
                "bundleName": "console",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "sass": {
                "silenceDeprecations": [
                  "import"
                ]
              }
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sak-frontend:build:production"
            },
            "development": {
              "buildTarget": "sak-frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4300,
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
