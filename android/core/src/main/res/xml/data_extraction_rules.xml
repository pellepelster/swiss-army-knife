<?xml version="1.0" encoding="utf-8"?>
<!-- nothing of an app goes to the cloud backup or a new phone (android 12 and later; allowBackup="false"
     of the apps covers the older ones): the session, the deployment and the e-mail address stay here -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
