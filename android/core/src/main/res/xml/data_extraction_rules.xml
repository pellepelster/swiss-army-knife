<?xml version="1.0" encoding="utf-8"?>
<!-- nothing of an app goes along: not to the cloud backup and not to a new phone (android 12 and
     later; allowBackup="false" of the apps covers the older ones). The session, the deployment and the
     e-mail address stay on this phone (AN-14) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
