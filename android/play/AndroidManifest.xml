<?xml version="1.0" encoding="utf-8"?>
<!-- the flavor play of every app (sak.android.app, build-logic): google play updates the app and forbids
     an app to install itself, so the permission and the receiver of the update of core are removed -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <receiver
            android:name="io.pelle.sak.core.update.UpdateReceiver"
            tools:node="remove" />
    </application>
</manifest>
